<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>zpp</AssemblyName>
    <Platforms>AnyCPU;x64;x86;ARM64</Platforms>
	<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	<!-- Required for single-file publish because this exe links MPXJ.Net (the Java MPXJ library
	     cross-compiled by IKVM, used by MicrosoftProjectFileImporter): IKVM's OpenJDK runtime image must
	     sit on disk and is resolved via Assembly.Location, both of which a default single-file bundle
	     breaks - the '<Module>' initializer then throws on MS Project import. Self-extracting ALL content
	     restores the image on disk and a real Assembly.Location. Inert unless PublishSingleFile=true. See
	     Zametek.ProjectPlan.csproj for the full explanation. -->
	<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
	<!-- SelfContained and PublishSingleFile are passed explicitly on the publish/build command line (see
	     makefile), not set here - shipping-critical flags kept explicit and loud. See
	     Zametek.ProjectPlan.csproj for the rationale. -->
	<PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="ConsoleTables" Version="2.7.0" />
	  <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
	  <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
	  <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageReference Include="Serilog" Version="4.4.0" />
	  <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
	  <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zametek.Graphs.Avalonia\Zametek.Graphs.Avalonia.csproj" />
    <ProjectReference Include="..\Zametek.ViewModel.ProjectPlan\Zametek.ViewModel.ProjectPlan.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zametek.ProjectPlan.CommandLine.Tests" />
  </ItemGroup>

</Project>
