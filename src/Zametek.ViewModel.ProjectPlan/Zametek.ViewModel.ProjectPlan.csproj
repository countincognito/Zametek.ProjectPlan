<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;ARM64</Platforms>
  </PropertyGroup>

  <!-- Enable the dormant cascade diagnostics (see CascadeDiagnostics.cs) in Debug
       builds only; their output goes through Debug.WriteLine, so they are useless
       in Release builds and would only add overhead there. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <!--<DefineConstants>$(DefineConstants);CASCADE_DIAGNOSTICS</DefineConstants>-->
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);IKVM0100;IKVM0101</NoWarn>
  </PropertyGroup>

  <ItemGroup>
	  <PackageReference Include="AutomaticGraphLayout.Drawing" Version="1.1.12" />
    <!-- DynamicData is explicit because ReactiveUI 24+ no longer ships it transitively. DynamicData
         and Dock.Model.ReactiveUI both still hard-depend on System.Reactive (as of 2026-08); once
         both go Rx-free, examine removing System.Reactive from the solution entirely (the
         ObservableExtensions.ObserveOn bridge is the seam to unwind). -->
    <PackageReference Include="Dock.Model.ReactiveUI" Version="12.1.0" />
    <PackageReference Include="Dock.Serializer.Newtonsoft" Version="12.1.0" />
    <PackageReference Include="DynamicData" Version="9.4.33" />
    <PackageReference Include="Ical.Net" Version="5.2.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="MPXJ.Net" Version="16.5.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NPOI" Version="[2.7.6,2.8.0)" />
	  <PackageReference Include="ScottPlot" Version="5.1.59" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.13" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
    <PackageReference Include="Zametek.Maths.Graphs.Compilers" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zametek.Common.ProjectPlan\Zametek.Common.ProjectPlan.csproj" />
    <ProjectReference Include="..\Zametek.Contract.ProjectPlan\Zametek.Contract.ProjectPlan.csproj" />
    <ProjectReference Include="..\Zametek.Data.ProjectPlan\Zametek.Data.ProjectPlan.csproj" />
    <ProjectReference Include="..\Zametek.Graphs.Avalonia\Zametek.Graphs.Avalonia.csproj" />
    <ProjectReference Include="..\Zametek.Resource.ProjectPlan\Zametek.Resource.ProjectPlan.csproj" />
  </ItemGroup>

</Project>
