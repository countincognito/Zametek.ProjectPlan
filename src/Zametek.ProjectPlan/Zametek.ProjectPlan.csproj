<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<OutputType>WinExe</OutputType>
	<TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
	<ApplicationManifest>app.manifest</ApplicationManifest>
	<ApplicationIcon>Assets\zpp.ico</ApplicationIcon>
	<AssemblyName>projectplandotnet</AssemblyName>
	<Platforms>AnyCPU;x86;x64;ARM64</Platforms>
	<StartupObject>Zametek.ProjectPlan.Program</StartupObject>
	<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	<!-- MPXJ.Net is the Java MPXJ library cross-compiled by IKVM; its OpenJDK runtime image (native
	     jvm.dll etc. plus data files, emitted under runtimes/<rid>/native) must sit on disk, and IKVM
	     resolves it via Assembly.Location. A default single-file publish bundles the managed assemblies
	     (so Assembly.Location is empty) and leaves the image's data files loose, so IKVM's bootstrap (the
	     '<Module>' initializer) throws when an MS Project file is imported. Self-extracting ALL content
	     restores the full image on disk and a real Assembly.Location, so IKVM initialises. This supersedes
	     IncludeNativeLibrariesForSelfExtract above (kept for clarity); it only affects single-file publish. -->
	<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
	<!-- SelfContained and PublishSingleFile are passed explicitly on the publish/build command line (see
	     makefile), not set here: they are shipping-critical, historically flaky as project properties, and
	     fail silently (a mis-resolved self-contained yields a framework-dependent build that only breaks on
	     a machine without the matching runtime). Keeping them on the command line makes them explicit and
	     fail loudly if the RID is missing. -->
	<PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <None Remove=".gitignore" />
    <AvaloniaResource Include="Assets\**" />
    <Content Include="Assets\zpp.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Autofac" Version="9.3.1" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Dock.Avalonia.Themes.Simple" Version="12.0.0.2" />
    <PackageReference Include="Irihi.Ursa.Themes.Semi" Version="2.1.0" />
    <PackageReference Include="ReactiveUI.Avalonia" Version="12.0.3" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Splat.Autofac" Version="19.4.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Zametek.Graphs.Avalonia\Zametek.Graphs.Avalonia.csproj" />
    <ProjectReference Include="..\Zametek.Resource.ProjectPlan\Zametek.Resource.ProjectPlan.csproj" />
    <ProjectReference Include="..\Zametek.View.ProjectPlan\Zametek.View.ProjectPlan.csproj" />
    <ProjectReference Include="..\Zametek.ViewModel.ProjectPlan\Zametek.ViewModel.ProjectPlan.csproj" />
  </ItemGroup>
</Project>
