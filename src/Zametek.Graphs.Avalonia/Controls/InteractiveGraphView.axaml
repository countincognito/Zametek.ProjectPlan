<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:g="using:Zametek.Graphs.Avalonia"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:converters="using:Avalonia.Controls.Converters"
             x:DataType="g:IInteractiveGraph"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Zametek.Graphs.Avalonia.InteractiveGraphView">
  <UserControl.Resources>
    <g:ThemeToBackgroundConverter x:Key="themeToBackgroundConverter"/>
    <converters:EnumToBoolConverter x:Key="enumToBool"/>
    <g:HalfNegativeConverter x:Key="halfNegative"/>

    <!-- Default node body. The node ContentPresenter binds its ContentTemplate to this via a
         DynamicResource (NOT a per-item RelativeSource ancestor binding, which floods the log with
         "Ancestor not found" as items tear down on a rebuild); the code-behind overwrites this resource
         entry when a host sets NodeTemplate, so a re-skin still flows through. Only the body is templated:
         node positioning, dragging, the selection ring and dimming are owned by the control (see the node
         ItemsControl below), so a replacement need only draw the body from IGraphNodeViewModel. -->
    <DataTemplate x:Key="GraphNodeBodyTemplate" x:DataType="g:IGraphNodeViewModel">
      <Grid Background="Transparent">
        <!-- Node body: fill + slack/override border, dashed for critical/dummy. -->
        <Rectangle Fill="{Binding Path=FillBrush, Mode=OneWay}"
                   Stroke="{Binding Path=BorderBrush, Mode=OneWay}"
                   StrokeThickness="{Binding Path=BorderThickness, Mode=OneWay}"
                   StrokeDashArray="{Binding Path=StrokeDashArray, Mode=OneWay}"
                   RadiusX="{Binding Path=CornerRadius, Mode=OneWay}"
                   RadiusY="{Binding Path=CornerRadius, Mode=OneWay}"/>
        <TextBlock Text="{Binding Path=Label, Mode=OneWay}"
                   FontFamily="{Binding Path=LabelFontFamily, Mode=OneWay}"
                   FontSize="{Binding Path=LabelFontSize, Mode=OneWay}"
                   Foreground="{Binding Path=LabelBrush, Mode=OneWay}"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"/>
      </Grid>
    </DataTemplate>

    <!-- Default edge appearance. The edge ContentPresenter binds its ContentTemplate to this via a
         DynamicResource (see the node body note above); the code-behind overwrites it when a host sets
         EdgeTemplate. The wide invisible hit area and its tooltip are owned by the control (see the edge
         ItemsControl below), so a replacement need only draw the line, arrowhead and label from
         IGraphEdgeViewModel. -->
    <DataTemplate x:Key="GraphEdgeBodyTemplate" x:DataType="g:IGraphEdgeViewModel">
      <Canvas>
        <Path Data="{Binding Path=EdgeGeometry, Mode=OneWay}"
              Stroke="{Binding Path=Stroke, Mode=OneWay}"
              StrokeThickness="{Binding Path=StrokeThickness, Mode=OneWay}"
              StrokeDashArray="{Binding Path=StrokeDashArray, Mode=OneWay}"
              Opacity="{Binding Path=EdgeOpacity, Mode=OneWay}"
              IsHitTestVisible="False"/>
        <Polygon Points="{Binding Path=ArrowPoints, Mode=OneWay}"
                 Fill="{Binding Path=Stroke, Mode=OneWay}"
                 Opacity="{Binding Path=EdgeOpacity, Mode=OneWay}"
                 ToolTip.Tip="{Binding Path=Tooltip, Mode=OneWay}"/>
        <!-- Optional edge label, centred on the lifted edge midpoint. LabelX/LabelY give the anchor
             point; the RenderTransform shifts the TextBlock by half its own rendered size so it is
             centred on that point (matching the export renderer) rather than starting there and
             spilling over the successor node. -->
        <TextBlock Name="edgeLabel"
                   Canvas.Left="{Binding Path=LabelX, Mode=OneWay}"
                   Canvas.Top="{Binding Path=LabelY, Mode=OneWay}"
                   Text="{Binding Path=Label, Mode=OneWay}"
                   IsVisible="{Binding Path=ShowLabel, Mode=OneWay}"
                   Foreground="{Binding Path=LabelBrush, Mode=OneWay}"
                   Opacity="{Binding Path=EdgeOpacity, Mode=OneWay}"
                   FontFamily="{Binding Path=LabelFontFamily, Mode=OneWay}"
                   FontSize="{Binding Path=LabelFontSize, Mode=OneWay}"
                   ToolTip.Tip="{Binding Path=Tooltip, Mode=OneWay}">
          <TextBlock.RenderTransform>
            <TranslateTransform X="{Binding #edgeLabel.Bounds.Width, Converter={StaticResource halfNegative}}"
                                Y="{Binding #edgeLabel.Bounds.Height, Converter={StaticResource halfNegative}}"/>
          </TextBlock.RenderTransform>
        </TextBlock>
      </Canvas>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel>
    <DockPanel Width="250"
               DockPanel.Dock="Top">
      <TextBlock Margin="0,11,11,11"
                 DockPanel.Dock="Right"
                 Text="x"/>
      <TextBlock Margin="0,11,0,11"
                 DockPanel.Dock="Right"
                 Text="{Binding ElementName=zoomer, Path=Value, Mode=OneWay, StringFormat=\{0:N1\}}"/>
      <Slider Name="zoomer"
              Orientation="Horizontal"
              Value="1"
              PointerWheelChanged="Zoom_PointerWheelChanged"
              ValueChanged="Slider_ValueChanged"
              Minimum="0.1" Maximum="5"
              Margin="11"/>
    </DockPanel>

    <!-- Viewport: clips the content; dragging the background pans, the wheel/slider zoom.
         Panning is unbounded (a render transform, not a scroll region), so nodes dragged
         anywhere stay reachable. -->
    <Border Name="viewport"
            ClipToBounds="True"
            Background="{Binding Path=Theme, Mode=OneWay, Converter={StaticResource themeToBackgroundConverter}}"
            PointerPressed="Viewport_PointerPressed"
            PointerMoved="Viewport_PointerMoved"
            PointerReleased="Viewport_PointerReleased"
            PointerWheelChanged="Zoom_PointerWheelChanged"
            SizeChanged="Graph_SizeChanged">
      <Border.ContextMenu>
        <ContextMenu>
          <MenuItem Header="{x:Static g:Graphs_Menus.Menu_FitToView}"
                    Click="FitToView_Click"/>
          
          <MenuItem Header="{x:Static g:Graphs_Menus.Menu_ResetGraphLayout}"
                    Click="ResetLayout_Click"/>
          
          <Separator/>
          
          <!-- Only the arrow graph offers the show-names toggle; hidden otherwise. -->
          <MenuItem Header="{x:Static g:Graphs_Menus.Menu_ShowNames}"
                    IsChecked="{Binding Path=ShowNames, Mode=TwoWay}"
                    IsVisible="{Binding Path=SupportsShowNames, Mode=OneWay}"
                    ToggleType="CheckBox"/>
          
          <!-- Edge routing: radio items whose check state reflects the current mode (OneWay via the
               built-in EnumToBoolConverter) and whose click sets it through the command. -->
          <MenuItem Header="{x:Static g:Graphs_Menus.Menu_EdgeRouting}">
            <MenuItem Header="{x:Static g:Graphs_Enums.Enum_EdgeRouting_Spline}"
                      IsChecked="{Binding Path=EdgeRoutingMode, Converter={StaticResource enumToBool}, ConverterParameter={x:Static g:GraphEdgeRoutingMode.Spline}, Mode=OneWay}"
                      Command="{Binding Path=ChangeEdgeRoutingModeCommand, Mode=OneWay}"
                      CommandParameter="{x:Static g:GraphEdgeRoutingMode.Spline}"
                      ToggleType="Radio"/>
            <MenuItem Header="{x:Static g:Graphs_Enums.Enum_EdgeRouting_SplineBundling}"
                      IsChecked="{Binding Path=EdgeRoutingMode, Converter={StaticResource enumToBool}, ConverterParameter={x:Static g:GraphEdgeRoutingMode.SplineBundling}, Mode=OneWay}"
                      Command="{Binding Path=ChangeEdgeRoutingModeCommand, Mode=OneWay}"
                      CommandParameter="{x:Static g:GraphEdgeRoutingMode.SplineBundling}"
                      ToggleType="Radio"/>
            <MenuItem Header="{x:Static g:Graphs_Enums.Enum_EdgeRouting_StraightLine}"
                      IsChecked="{Binding Path=EdgeRoutingMode, Converter={StaticResource enumToBool}, ConverterParameter={x:Static g:GraphEdgeRoutingMode.StraightLine}, Mode=OneWay}"
                      Command="{Binding Path=ChangeEdgeRoutingModeCommand, Mode=OneWay}"
                      CommandParameter="{x:Static g:GraphEdgeRoutingMode.StraightLine}"
                      ToggleType="Radio"/>
            <MenuItem Header="{x:Static g:Graphs_Enums.Enum_EdgeRouting_SugiyamaSplines}"
                      IsChecked="{Binding Path=EdgeRoutingMode, Converter={StaticResource enumToBool}, ConverterParameter={x:Static g:GraphEdgeRoutingMode.SugiyamaSplines}, Mode=OneWay}"
                      Command="{Binding Path=ChangeEdgeRoutingModeCommand, Mode=OneWay}"
                      CommandParameter="{x:Static g:GraphEdgeRoutingMode.SugiyamaSplines}"
                      ToggleType="Radio"/>
            <MenuItem Header="{x:Static g:Graphs_Enums.Enum_EdgeRouting_Rectilinear}"
                      IsChecked="{Binding Path=EdgeRoutingMode, Converter={StaticResource enumToBool}, ConverterParameter={x:Static g:GraphEdgeRoutingMode.Rectilinear}, Mode=OneWay}"
                      Command="{Binding Path=ChangeEdgeRoutingModeCommand, Mode=OneWay}"
                      CommandParameter="{x:Static g:GraphEdgeRoutingMode.Rectilinear}"
                      ToggleType="Radio"/>
            <MenuItem Header="{x:Static g:Graphs_Enums.Enum_EdgeRouting_RectilinearToCenter}"
                      IsChecked="{Binding Path=EdgeRoutingMode, Converter={StaticResource enumToBool}, ConverterParameter={x:Static g:GraphEdgeRoutingMode.RectilinearToCenter}, Mode=OneWay}"
                      Command="{Binding Path=ChangeEdgeRoutingModeCommand, Mode=OneWay}"
                      CommandParameter="{x:Static g:GraphEdgeRoutingMode.RectilinearToCenter}"
                      ToggleType="Radio"/>
            <MenuItem Header="{x:Static g:Graphs_Enums.Enum_EdgeRouting_None}"
                      IsChecked="{Binding Path=EdgeRoutingMode, Converter={StaticResource enumToBool}, ConverterParameter={x:Static g:GraphEdgeRoutingMode.None}, Mode=OneWay}"
                      Command="{Binding Path=ChangeEdgeRoutingModeCommand, Mode=OneWay}"
                      CommandParameter="{x:Static g:GraphEdgeRoutingMode.None}"
                      ToggleType="Radio"/>
          </MenuItem>
          
          <Separator/>

          <!-- Copy / Save each offer explicit Vector and High-Fidelity entries; which appear is gated by
               ShowVectorExportOptions / ShowRasterExportOptions (applied in code-behind by the Tag, to
               avoid binding a control property across the context-menu popup boundary). -->
          <MenuItem Header="{x:Static g:Graphs_Menus.Menu_CopyImage}">
            <MenuItem Tag="export-vector"
                      Header="{x:Static g:Graphs_Menus.Menu_ExportVector}"
                      Click="CopyVector_Click"/>
            <MenuItem Tag="export-raster"
                      Header="{x:Static g:Graphs_Menus.Menu_ExportHighFidelity}"
                      Click="CopyRaster_Click"/>
          </MenuItem>

          <MenuItem Header="{x:Static g:Graphs_Menus.Menu_SaveAs}">
            <MenuItem Tag="export-vector"
                      Header="{x:Static g:Graphs_Menus.Menu_ExportVector}"
                      Command="{Binding Path=SaveGraphImageWithModeCommand, Mode=OneWay}"
                      CommandParameter="{x:Static g:GraphExportMode.Vector}"/>
            <MenuItem Tag="export-raster"
                      Header="{x:Static g:Graphs_Menus.Menu_ExportHighFidelity}"
                      Command="{Binding Path=SaveGraphImageWithModeCommand, Mode=OneWay}"
                      CommandParameter="{x:Static g:GraphExportMode.Raster}"/>
          </MenuItem>
        </ContextMenu>
      </Border.ContextMenu>

      <!-- panLayer carries the pan TranslateTransform (assigned in code-behind);
           graphCanvas carries the zoom ScaleTransform (bound to the slider). -->
      <Canvas Name="panLayer" RenderTransformOrigin="0,0">
        <Canvas Name="graphCanvas"
                Width="{Binding Path=WorkspaceWidth, Mode=OneWay}"
                Height="{Binding Path=WorkspaceHeight, Mode=OneWay}"
                ClipToBounds="False"
                RenderTransformOrigin="0,0"
                SizeChanged="Graph_SizeChanged">
          <Canvas.RenderTransform>
            <ScaleTransform ScaleX="{Binding Value, ElementName=zoomer, Mode=OneWay}"
                            ScaleY="{Binding Value, ElementName=zoomer, Mode=OneWay}"/>
          </Canvas.RenderTransform>

          <!-- Edges drawn underneath the nodes. Sized so the items panel arranges
               (ClipToBounds is false, so nodes dragged beyond still render). -->
          <ItemsControl ItemsSource="{Binding Path=GraphEdges, Mode=OneWay}"
                        Width="{Binding Path=WorkspaceWidth, Mode=OneWay}"
                        Height="{Binding Path=WorkspaceHeight, Mode=OneWay}"
                        ClipToBounds="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="g:IGraphEdgeViewModel">
                <Canvas>
                  <!-- Invisible wide hit area so a thin edge is easy to hover for its tooltip.
                       Transparent (not null) so it is hit-test visible; the tooltip is empty for
                       graphs (e.g. vertex) whose edges carry none. Follows the routed curve. Owned by
                       the control so a host-supplied EdgeTemplate keeps its hover tooltip. -->
                  <Path Data="{Binding Path=EdgeGeometry, Mode=OneWay}"
                        Stroke="Transparent"
                        StrokeThickness="14"
                        ToolTip.Tip="{Binding Path=Tooltip, Mode=OneWay}"/>
                  <!-- Swappable edge appearance (defaults to DefaultEdgeTemplate). -->
                  <ContentPresenter Content="{Binding}"
                                    ContentTemplate="{DynamicResource GraphEdgeBodyTemplate}"/>
                </Canvas>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Nodes: draggable, selectable, with hover tooltips. -->
          <ItemsControl ItemsSource="{Binding Path=GraphNodes, Mode=OneWay}"
                        Width="{Binding Path=WorkspaceWidth, Mode=OneWay}"
                        Height="{Binding Path=WorkspaceHeight, Mode=OneWay}"
                        ClipToBounds="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <!-- Position each node container on the panel via the container theme. A bare
                 "ContentPresenter" style selector also matches the presenter inside a node's ToolTip
                 (whose DataContext is the tooltip string), so the compiled X/Y binding would throw
                 InvalidCastException; but scoping it by selector fails the other way (a container's
                 styling parent is the ItemsControl, not the Canvas, so a child-combinator selector
                 never matches it, leaving the nodes unpositioned at the origin). ItemContainerTheme
                 applies ONLY to the generated item containers, so it does both: positions every node
                 and never touches the tooltip presenter. -->
            <ItemsControl.ItemContainerTheme>
              <ControlTheme TargetType="ContentPresenter" x:DataType="g:IGraphNodeViewModel">
                <Setter Property="Canvas.Left" Value="{Binding Path=X, Mode=OneWay}"/>
                <Setter Property="Canvas.Top" Value="{Binding Path=Y, Mode=OneWay}"/>
              </ControlTheme>
            </ItemsControl.ItemContainerTheme>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="g:IGraphNodeViewModel">
                <!-- Library-owned node chrome: sizing, interaction (drag), hover tooltip, dimming and
                     the selection ring. The body is the swappable NodeTemplate (defaults to
                     DefaultNodeTemplate); a replacement need only draw the body from IGraphNodeViewModel. -->
                <Grid Width="{Binding Path=Width, Mode=OneWay}"
                      Height="{Binding Path=Height, Mode=OneWay}"
                      Opacity="{Binding Path=NodeOpacity, Mode=OneWay}"
                      Background="Transparent"
                      Cursor="Hand"
                      ToolTip.Tip="{Binding Path=Tooltip, Mode=OneWay}">
                  <i:Interaction.Behaviors>
                    <g:GraphNodeDragBehavior/>
                  </i:Interaction.Behaviors>
                  <ContentPresenter Content="{Binding}"
                                    ContentTemplate="{DynamicResource GraphNodeBodyTemplate}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"/>
                  <!-- Selection ring: control-owned so every node body shows selection consistently;
                       sits over the body so it never hides the slack colour. -->
                  <Rectangle Stroke="{Binding Path=SelectionBrush, Mode=OneWay}"
                             StrokeThickness="3"
                             RadiusX="{Binding Path=CornerRadius, Mode=OneWay}"
                             RadiusY="{Binding Path=CornerRadius, Mode=OneWay}"
                             IsHitTestVisible="False"
                             IsVisible="{Binding Path=IsSelected, Mode=OneWay}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Canvas>
      </Canvas>
    </Border>
  </DockPanel>
</UserControl>
