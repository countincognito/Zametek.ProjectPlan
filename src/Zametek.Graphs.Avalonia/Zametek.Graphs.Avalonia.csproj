<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Platforms>AnyCPU;ARM64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zametek.Graphs.Avalonia.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The graph label font (SIL Open Font License, Assets/Fonts/OFL.txt); see GraphFonts. -->
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutomaticGraphLayout.Drawing" Version="1.1.12" />
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
    <!-- Held at 5.1.1, the last release on SkiaSharp 3. From 5.2.0, Svg.Skia requires SkiaSharp 4.148, which
         lifts the whole solution onto it: Avalonia and ScottPlot are still built against SkiaSharp 3.119, and
         the native libraries pinned here and in the browser head no longer match the managed ones, so every
         draw on Linux fails. Move it with them once Avalonia and ScottPlot are on SkiaSharp 4. -->
    <PackageReference Include="Svg.Skia" Version="5.1.1" />
    <!-- Explicit dependency: ReactiveUI 24+ no longer ships System.Reactive transitively. Examine
         removing System.Reactive from the solution once DynamicData and Dock both go Rx-free
         (as of 2026-08 both still hard-depend on it, so it ships regardless). -->
    <PackageReference Include="System.Reactive" Version="7.0.0" />
    <PackageReference Include="Xaml.Behaviors.Avalonia" Version="12.0.7" />
    <PackageReference Include="Zametek.Utility" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Graphs_Messages.Designer.cs">
      <DependentUpon>Graphs_Messages.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="Graphs_Menus.Designer.cs">
      <DependentUpon>Graphs_Menus.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="Graphs_Enums.Designer.cs">
      <DependentUpon>Graphs_Enums.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Graphs_Messages.resx">
      <LastGenOutput>Graphs_Messages.Designer.cs</LastGenOutput>
      <Generator>PublicResXFileCodeGenerator</Generator>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Update="Graphs_Menus.resx">
      <LastGenOutput>Graphs_Menus.Designer.cs</LastGenOutput>
      <Generator>PublicResXFileCodeGenerator</Generator>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Update="Graphs_Enums.resx">
      <LastGenOutput>Graphs_Enums.Designer.cs</LastGenOutput>
      <Generator>PublicResXFileCodeGenerator</Generator>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>
</Project>
