<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:resources="using:Zametek.Resource.ProjectPlan"
			 xmlns:local="using:Zametek.View.ProjectPlan"
			 xmlns:vm="using:Zametek.ViewModel.ProjectPlan"
			 x:DataType="vm:MetricManagerViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="200"
             x:Class="Zametek.View.ProjectPlan.MetricManagerView">
	<UserControl.Resources>
	</UserControl.Resources>

	<ScrollViewer VerticalScrollBarVisibility="Auto"
				  HorizontalScrollBarVisibility="Disabled">
		<WrapPanel Margin="7"
				   Grid.IsSharedSizeScope="True"
				   Background="Transparent"
				   Orientation="Horizontal">
			<WrapPanel.ContextMenu>
				<ContextMenu>
					<MenuItem Header="{x:Static resources:Menus.Menu_CopyTable}"
							  Click="CopyTable_Click" />
				</ContextMenu>
			</WrapPanel.ContextMenu>
			<Grid Margin="7">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" SharedSizeGroup="MetricLabel"/>
					<ColumnDefinition Width="Auto" SharedSizeGroup="MetricValue"/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<SelectableTextBlock Grid.Column="0" Grid.Row="0"
					                 VerticalAlignment="Center"
					                 HorizontalAlignment="Right"
								     Text="{Binding Source={x:Static resources:Labels.Label_ActivityRisk}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="0"
									 VerticalAlignment="Center"
									 Margin="7,0,0,0"
									 FontWeight="Bold"
									 Text="{Binding Path=ActivityRisk, Mode=OneWay, StringFormat=\{0:N2\}}"/>

				<SelectableTextBlock Grid.Column="0" Grid.Row="1"
					                 VerticalAlignment="Center"
					                 HorizontalAlignment="Right"
					                 Text="{Binding Source={x:Static resources:Labels.Label_ActivityRiskWithStdDevCorrection}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="1"
						             VerticalAlignment="Center"
						             Margin="7,0,0,0"
						             FontWeight="Bold"
						             Text="{Binding Path=ActivityRiskWithStdDevCorrection, Mode=OneWay, StringFormat=\{0:N2\}}"/>

				<SelectableTextBlock Grid.Column="0" Grid.Row="2"
					                 VerticalAlignment="Center"
					                 HorizontalAlignment="Right"
								     Text="{Binding Source={x:Static resources:Labels.Label_CriticalityRisk}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="2"
						             VerticalAlignment="Center"
						             Margin="7,0,0,0"
						             FontWeight="Bold"
						             Text="{Binding Path=CriticalityRisk, Mode=OneWay, StringFormat=\{0:N2\}}"/>

				<SelectableTextBlock Grid.Column="0" Grid.Row="3"
					                 VerticalAlignment="Center"
					                 HorizontalAlignment="Right"
								     Text="{Binding Source={x:Static resources:Labels.Label_FibonacciRisk}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="3"
						             VerticalAlignment="Center"
						             Margin="7,0,0,0"
						             FontWeight="Bold"
						             Text="{Binding Path=FibonacciRisk, Mode=OneWay, StringFormat=\{0:N2\}}"/>
			</Grid>

			<Grid Margin="7">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" SharedSizeGroup="MetricLabel"/>
					<ColumnDefinition Width="Auto" SharedSizeGroup="MetricValue"/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<SelectableTextBlock Grid.Column="0" Grid.Row="0"
					                 VerticalAlignment="Center"
					                 HorizontalAlignment="Right"
								     Text="{Binding Source={x:Static resources:Labels.Label_CyclomaticComplexity}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="0"
						             VerticalAlignment="Center"
						             Margin="7,0,0,0"
						             FontWeight="Bold"
						             Text="{Binding Path=NetworkCyclomaticComplexity, Mode=OneWay, StringFormat=\{0:N0\}}"/>

				<SelectableTextBlock Grid.Column="0" Grid.Row="1"
					                 VerticalAlignment="Center"
					                 HorizontalAlignment="Right"
								     Text="{Binding Source={x:Static resources:Labels.Label_GeometricActivityRisk}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="1"
						             VerticalAlignment="Center"
						             Margin="7,0,0,0"
						             FontWeight="Bold"
						             Text="{Binding Path=GeometricActivityRisk, Mode=OneWay, StringFormat=\{0:N2\}}"/>

				<SelectableTextBlock Grid.Column="0" Grid.Row="2"
					                 VerticalAlignment="Center"
					                 HorizontalAlignment="Right"
								     Text="{Binding Source={x:Static resources:Labels.Label_GeometricCriticalityRisk}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="2"
						             VerticalAlignment="Center"
						             Margin="7,0,0,0"
						             FontWeight="Bold"
						             Text="{Binding Path=GeometricCriticalityRisk, Mode=OneWay, StringFormat=\{0:N2\}}"/>

				<SelectableTextBlock Grid.Column="0" Grid.Row="3"
					                 VerticalAlignment="Center"
					                 HorizontalAlignment="Right"
								     Text="{Binding Source={x:Static resources:Labels.Label_GeometricFibonacciRisk}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="3"
						             VerticalAlignment="Center"
						             Margin="7,0,0,0"
						             FontWeight="Bold"
						             Text="{Binding Path=GeometricFibonacciRisk, Mode=OneWay, StringFormat=\{0:N2\}}"/>
			</Grid>

			<Grid Margin="7">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" SharedSizeGroup="MetricLabel"/>
					<ColumnDefinition Width="Auto" SharedSizeGroup="MetricValue"/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<SelectableTextBlock Grid.Column="0" Grid.Row="0"
					                 VerticalAlignment="Center"
					                 HorizontalAlignment="Right"
								     Text="{Binding Source={x:Static resources:Labels.Label_ActivityEffort}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="0"
						             VerticalAlignment="Center"
						             Margin="7,0,0,0"
						             FontWeight="Bold"
						             Text="{Binding Path=ActivityEffort, Mode=OneWay, StringFormat=\{0:N0\}}"/>

				<SelectableTextBlock Grid.Column="0" Grid.Row="1"
					                 VerticalAlignment="Center"
					                 HorizontalAlignment="Right"
								     Text="{Binding Source={x:Static resources:Labels.Label_DurationManMonths}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="1"
						             VerticalAlignment="Center"
						             Margin="7,0,0,0"
						             FontWeight="Bold"
						             Text="{Binding Path=NetworkDurationManMonths, Mode=OneWay, StringFormat=\{0:N1\}}"/>

				<SelectableTextBlock Grid.Column="0" Grid.Row="2"
					                 VerticalAlignment="Center"
					                 HorizontalAlignment="Right"
								     Text="{Binding Source={x:Static resources:Labels.Label_ProjectFinish}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="2"
						             VerticalAlignment="Center"
						             Margin="7,0,0,0"
						             FontWeight="Bold"
						             Text="{Binding Path=ProjectFinish, Mode=OneWay}"/>

				<SelectableTextBlock Grid.Column="0" Grid.Row="3"
					                 VerticalAlignment="Center"
					                 HorizontalAlignment="Right"
								     Text="{Binding Source={x:Static resources:Labels.Label_EffortEfficiency}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="3"
						             VerticalAlignment="Center"
						             Margin="7,0,0,0"
						             FontWeight="Bold"
						             Text="{Binding Path=EffortEfficiency, Mode=OneWay, StringFormat=\{0:P1\}}"/>
			</Grid>

			<Grid Margin="7">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" SharedSizeGroup="MetricLabel"/>
					<ColumnDefinition Width="Auto" SharedSizeGroup="MetricValue"/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<SelectableTextBlock Grid.Column="0" Grid.Row="0"
					                 VerticalAlignment="Center"
					                 HorizontalAlignment="Right"
								     Text="{Binding Source={x:Static resources:Labels.Label_DirectEffort}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="0"
						             VerticalAlignment="Center"
						             Margin="7,0,0,0"
						             FontWeight="Bold"
						             Text="{Binding Path=DirectEffort, Mode=OneWay, StringFormat=\{0:N0\}}"/>

				<SelectableTextBlock Grid.Column="0" Grid.Row="1"
					                 VerticalAlignment="Center"
								     HorizontalAlignment="Right"
							    	 Text="{Binding Source={x:Static resources:Labels.Label_IndirectEffort}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="1"
						             VerticalAlignment="Center"
						             Margin="7,0,0,0"
						             FontWeight="Bold"
						             Text="{Binding Path=IndirectEffort, Mode=OneWay, StringFormat=\{0:N0\}}"/>

				<SelectableTextBlock Grid.Column="0" Grid.Row="2"
					                 VerticalAlignment="Center"
								     HorizontalAlignment="Right"
								     Text="{Binding Source={x:Static resources:Labels.Label_OtherEffort}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="2"
						             VerticalAlignment="Center"
						             Margin="7,0,0,0"
						             FontWeight="Bold"
						             Text="{Binding Path=OtherEffort, Mode=OneWay, StringFormat=\{0:N0\}}"/>

				<SelectableTextBlock Grid.Column="0" Grid.Row="3"
					                 VerticalAlignment="Center"
					                 HorizontalAlignment="Right"
								     Text="{Binding Source={x:Static resources:Labels.Label_TotalEffort}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="3"
						             VerticalAlignment="Center"
						             Margin="7,0,0,0"
						             FontWeight="Bold"
						             Text="{Binding Path=TotalEffort, Mode=OneWay, StringFormat=\{0:N0\}}"/>
			</Grid>

			<Grid Margin="7"
				  IsVisible="{Binding Path=!HideCost, Mode=OneWay}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" SharedSizeGroup="MetricLabel"/>
					<ColumnDefinition Width="Auto" SharedSizeGroup="MetricValue"/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<SelectableTextBlock Grid.Column="0" Grid.Row="0"
					                 VerticalAlignment="Center"
					                 HorizontalAlignment="Right"
								     Text="{Binding Source={x:Static resources:Labels.Label_DirectCost}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="0"
						             VerticalAlignment="Center"
						             Margin="7,0,0,0"
						             FontWeight="Bold"
						             Text="{Binding Path=DirectCost, Mode=OneWay, StringFormat=\{0:N2\}}"/>

				<SelectableTextBlock Grid.Column="0" Grid.Row="1"
					                 VerticalAlignment="Center"
								     HorizontalAlignment="Right"
							    	 Text="{Binding Source={x:Static resources:Labels.Label_IndirectCost}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="1"
						             VerticalAlignment="Center"
						             Margin="7,0,0,0"
						             FontWeight="Bold"
						             Text="{Binding Path=IndirectCost, Mode=OneWay, StringFormat=\{0:N2\}}"/>

				<SelectableTextBlock Grid.Column="0" Grid.Row="2"
					                 VerticalAlignment="Center"
								     HorizontalAlignment="Right"
								     Text="{Binding Source={x:Static resources:Labels.Label_OtherCost}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="2"
						             VerticalAlignment="Center"
						             Margin="7,0,0,0"
						             FontWeight="Bold"
						             Text="{Binding Path=OtherCost, Mode=OneWay, StringFormat=\{0:N2\}}"/>

				<SelectableTextBlock Grid.Column="0" Grid.Row="3"
					                 VerticalAlignment="Center"
					                 HorizontalAlignment="Right"
								     Text="{Binding Source={x:Static resources:Labels.Label_TotalCost}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="3"
						             VerticalAlignment="Center"
						             Margin="7,0,0,0"
						             FontWeight="Bold"
						             Text="{Binding Path=TotalCost, Mode=OneWay, StringFormat=\{0:N2\}}"/>
			</Grid>

			<Grid Margin="7"
				  IsVisible="{Binding Path=!HideBilling, Mode=OneWay}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" SharedSizeGroup="MetricLabel"/>
					<ColumnDefinition Width="Auto" SharedSizeGroup="MetricValue"/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<SelectableTextBlock Grid.Column="0" Grid.Row="0"
					                 VerticalAlignment="Center"
					                 HorizontalAlignment="Right"
								     Text="{Binding Source={x:Static resources:Labels.Label_DirectBilling}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="0"
						             VerticalAlignment="Center"
						             Margin="7,0,0,0"
						             FontWeight="Bold"
						             Text="{Binding Path=DirectBilling, Mode=OneWay, StringFormat=\{0:N2\}}"/>

				<SelectableTextBlock Grid.Column="0" Grid.Row="1"
					                 VerticalAlignment="Center"
								     HorizontalAlignment="Right"
							    	 Text="{Binding Source={x:Static resources:Labels.Label_IndirectBilling}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="1"
						             VerticalAlignment="Center"
						             Margin="7,0,0,0"
						             FontWeight="Bold"
						             Text="{Binding Path=IndirectBilling, Mode=OneWay, StringFormat=\{0:N2\}}"/>

				<SelectableTextBlock Grid.Column="0" Grid.Row="2"
					                 VerticalAlignment="Center"
								     HorizontalAlignment="Right"
								     Text="{Binding Source={x:Static resources:Labels.Label_OtherBilling}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="2"
						             VerticalAlignment="Center"
						             Margin="7,0,0,0"
						             FontWeight="Bold"
						             Text="{Binding Path=OtherBilling, Mode=OneWay, StringFormat=\{0:N2\}}"/>

				<SelectableTextBlock Grid.Column="0" Grid.Row="3"
					                 VerticalAlignment="Center"
					                 HorizontalAlignment="Right"
								     Text="{Binding Source={x:Static resources:Labels.Label_TotalBilling}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="3"
						             VerticalAlignment="Center"
						             Margin="7,0,0,0"
						             FontWeight="Bold"
						             Text="{Binding Path=TotalBilling, Mode=OneWay, StringFormat=\{0:N2\}}"/>
			</Grid>

			<Grid Margin="7"
				  IsVisible="{Binding Path=!HideMargin, Mode=OneWay}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" SharedSizeGroup="MetricLabel"/>
					<ColumnDefinition Width="Auto" SharedSizeGroup="MetricValue"/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<SelectableTextBlock Grid.Column="0" Grid.Row="0"
					                 VerticalAlignment="Center"
					                 HorizontalAlignment="Right"
								     Text="{Binding Source={x:Static resources:Labels.Label_DirectMargin}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="0"
						             VerticalAlignment="Center"
						             Margin="7,0,0,0"
						             FontWeight="Bold">
					<SelectableTextBlock.Text>
						<MultiBinding StringFormat="{}{0:N2}{1}">
							<Binding Path="DirectMarginAbsolute" Mode="OneWay" />
							<Binding Path="DisplayDirectMargin" Mode="OneWay" />
						</MultiBinding>
					</SelectableTextBlock.Text>
				</SelectableTextBlock>

				<SelectableTextBlock Grid.Column="0" Grid.Row="1"
					                 VerticalAlignment="Center"
								     HorizontalAlignment="Right"
							    	 Text="{Binding Source={x:Static resources:Labels.Label_IndirectMargin}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="1"
						             VerticalAlignment="Center"
						             Margin="7,0,0,0"
						             FontWeight="Bold">
					<SelectableTextBlock.Text>
						<MultiBinding StringFormat="{}{0:N2}{1}">
							<Binding Path="IndirectMarginAbsolute" Mode="OneWay" />
							<Binding Path="DisplayIndirectMargin" Mode="OneWay" />
						</MultiBinding>
					</SelectableTextBlock.Text>
				</SelectableTextBlock>

				<SelectableTextBlock Grid.Column="0" Grid.Row="2"
					                 VerticalAlignment="Center"
								     HorizontalAlignment="Right"
								     Text="{Binding Source={x:Static resources:Labels.Label_OtherMargin}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="2"
						             VerticalAlignment="Center"
						             Margin="7,0,0,0"
						             FontWeight="Bold">
					<SelectableTextBlock.Text>
						<MultiBinding StringFormat="{}{0:N2}{1}">
							<Binding Path="OtherMarginAbsolute" Mode="OneWay" />
							<Binding Path="DisplayOtherMargin" Mode="OneWay" />
						</MultiBinding>
					</SelectableTextBlock.Text>
				</SelectableTextBlock>

				<SelectableTextBlock Grid.Column="0" Grid.Row="3"
					                 VerticalAlignment="Center"
					                 HorizontalAlignment="Right"
								     Text="{Binding Source={x:Static resources:Labels.Label_TotalMargin}, StringFormat=\{0\}:}"/>
				<SelectableTextBlock Grid.Column="1" Grid.Row="3"
						             VerticalAlignment="Center"
						             Margin="7,0,0,0"
						             FontWeight="Bold">
					<SelectableTextBlock.Text>
						<MultiBinding StringFormat="{}{0:N2}{1}">
							<Binding Path="TotalMarginAbsolute" Mode="OneWay" />
							<Binding Path="DisplayTotalMargin" Mode="OneWay" />
						</MultiBinding>
					</SelectableTextBlock.Text>
				</SelectableTextBlock>
			</Grid>
		</WrapPanel>
	</ScrollViewer>
</UserControl>
