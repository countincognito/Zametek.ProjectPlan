<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			       xmlns:resources="using:Zametek.Resource.ProjectPlan"
			       xmlns:local="using:Zametek.View.ProjectPlan"
			       xmlns:vm="using:Zametek.ViewModel.ProjectPlan"
			       xmlns:sys="using:System"
			       xmlns:contract="using:Zametek.Contract.ProjectPlan"
			       x:DataType="vm:EffortTrackingManagerViewModel"
			       xmlns:u="https://irihi.tech/ursa"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Zametek.View.ProjectPlan.EffortTrackingManagerView">
	<UserControl.Resources>
		<local:GDPdLengthConverter x:Key="GDPWidthConverter"/>
		<sys:Int32 x:Key="paginationPageSize">1</sys:Int32>
		<sys:Int32 x:Key="paginationTotalCount">10000</sys:Int32>
		<sys:Double x:Key="nameColumnMaxWidth">600</sys:Double>
	</UserControl.Resources>

	<DockPanel Margin="7">
		<DockPanel DockPanel.Dock="Bottom">
			<DockPanel.Styles>
				<Style Selector="#PART_QuickJumpInput"
					   x:SetterTargetType="{x:Type u:NumericIntUpDown}">
					<Setter Property="Minimum" Value="1"/>
				</Style>
			</DockPanel.Styles>
			<u:Pagination PageSize="{StaticResource paginationPageSize}"
						  TotalCount="{StaticResource paginationTotalCount}"
						  DockPanel.Dock="Left"
						  CurrentPage="{Binding Path=PageIndex, Mode=TwoWay}" />

			<u:Pagination PageSize="{StaticResource paginationPageSize}"
						  TotalCount="{StaticResource paginationTotalCount}"
						  Theme="{DynamicResource TinyPagination}"
						  DockPanel.Dock="Right"
						  CurrentPage="{Binding Path=PageIndex, Mode=TwoWay}"/>

      <Button DockPanel.Dock="Left"
          Command="{Binding Path=SyncTodayCommand, Mode=OneWay}"
          ToolTip.Tip="{x:Static resources:ToolTips.ToolTip_SyncToday}"
          Content="↺"
          FontSize="18"
          Padding="4,2"
          Margin="0,0,7,0"
          Width="30"
          VerticalAlignment="Center"
          VerticalContentAlignment="Center" />

      <Grid />
		</DockPanel>

		<DockPanel IsEnabled="{Binding Path=HasResources, Mode=OneWay}">
				<ScrollViewer HorizontalScrollBarVisibility="Disabled"
							  VerticalScrollBarVisibility="Auto">
					<ItemsControl ItemsSource="{Binding Path=TimesheetSections, Mode=OneWay}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="contract:IResourceTimesheetViewModel">
								<Expander IsExpanded="{Binding Path=IsExpanded, Mode=TwoWay}"
										  HorizontalAlignment="Stretch"
										  HorizontalContentAlignment="Stretch"
										  Padding="0"
										  Margin="0,0,0,2">
									<Expander.Header>
										<DockPanel>
											<Button DockPanel.Dock="Right"
													Margin="7,0,0,0"
													Padding="7,2"
													VerticalAlignment="Center"
													FontWeight="ExtraBold"
													ToolTip.Tip="{x:Static resources:ToolTips.ToolTip_Find}"
													Command="{Binding Path=Resource.TrackerSet.SetTrackerIndexCommand, Mode=OneWay}"
													CommandParameter="{Binding Path=Resource.TrackerSet.LastTrackerIndex, Mode=OneWay}"
													Content="{Binding Path=Resource.TrackerSet.SearchSymbol, Mode=OneWay}"/>
											<TextBlock Text="{Binding Path=Resource.Name, Mode=OneWay}"
													   FontWeight="Bold"
													   Padding="3"
													   VerticalAlignment="Center"/>
											<TextBlock Text="{Binding Path=Resource.Id, Mode=OneWay, StringFormat='({0})'}"
													   Opacity="0.6"
													   Padding="3"
													   VerticalAlignment="Center"/>
											<Grid/>
										</DockPanel>
									</Expander.Header>
									<StackPanel>
										<DataGrid FrozenColumnCount="25"
												  AutoGenerateColumns="False"
												  RowHeight="30"
												  ItemsSource="{Binding Path=Rows, Mode=OneWay}"
												  HorizontalScrollBarVisibility="Disabled"
												  VerticalScrollBarVisibility="Disabled"
												  SelectionMode="Extended"
												  CanUserResizeColumns="True"
												  CanUserSortColumns="False"
												  GridLinesVisibility="All"
												  CanUserReorderColumns="False">
											<DataGrid.Styles>
												<Style Selector="DataGridRow Grid.editable">
													<Setter Property="Background" Value="{DynamicResource EditableCellGridBackgroundBrush}"/>
												</Style>
												<Style Selector="DataGridRow:not(:pointerover) Grid.editable">
													<Setter Property="Background" Value="{DynamicResource EditableCellGridBackgroundBrush}"/>
												</Style>
												<Style Selector="DataGridRow:not(:selected) Grid.editable">
													<Setter Property="Background" Value="{DynamicResource EditableCellGridBackgroundBrush}"/>
												</Style>
												<Style Selector="DataGridRow:selected Grid.editable">
													<Setter Property="Background" Value="{DynamicResource EditableSelectedCellGridBackgroundBrush}"/>
												</Style>
												<Style Selector="DataGridRow:pointerover Grid.editable">
													<Setter Property="Background" Value="{DynamicResource EditableHoverCellGridBackgroundBrush}"/>
												</Style>
												<Style Selector="DataGridCell:selected:current:focus Grid.editable">
													<Setter Property="Background" Value="{DynamicResource EditableSelectedCurrentFocusCellGridBackgroundBrush}"/>
												</Style>

												<!-- Make sure the caret appears at the end of a TextBox -->
												<Style Selector="TextBox">
													<Setter Property="(Interaction.Behaviors)">
														<BehaviorCollectionTemplate>
															<BehaviorCollection>
																<local:MoveCaretToEndBehavior />
															</BehaviorCollection>
														</BehaviorCollectionTemplate>
													</Setter>
												</Style>
											</DataGrid.Styles>

											<DataGrid.Columns>
												<DataGridTemplateColumn CanUserResize="False"
																		CanUserReorder="False"
																		CanUserSort="False"
																		IsReadOnly="True"
																		Width="55">
													<DataGridTemplateColumn.HeaderTemplate>
														<DataTemplate>
															<TextBlock VerticalAlignment="Center"
																	   Margin="0"
																	   Padding="3"
																	   Text="{x:Static resources:Labels.Label_Id}"
																	   ToolTip.Tip="{x:Static resources:ToolTips.ToolTip_Id}"/>
														</DataTemplate>
													</DataGridTemplateColumn.HeaderTemplate>
													<DataGridTemplateColumn.CellTemplate>
														<DataTemplate x:DataType="contract:IResourceTimesheetRowViewModel">
															<Grid VerticalAlignment="Stretch">
																<TextBlock VerticalAlignment="Center"
																		   Margin="0"
																		   Padding="3"
																		   Text="{Binding Path=ActivityId, Mode=OneWay}"/>
															</Grid>
														</DataTemplate>
													</DataGridTemplateColumn.CellTemplate>
												</DataGridTemplateColumn>

												<DataGridTemplateColumn CanUserResize="True"
																		CanUserReorder="False"
																		CanUserSort="False"
																		MaxWidth="{StaticResource nameColumnMaxWidth}"
																		Width="{Binding Path=NameColumnWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource GDPWidthConverter}}">
													<DataGridTemplateColumn.HeaderTemplate>
														<DataTemplate>
															<TextBlock VerticalAlignment="Center"
																	   Margin="0"
																	   Padding="3"
																	   Text="{x:Static resources:Labels.Label_ActivityName}"
																	   ToolTip.Tip="{x:Static resources:ToolTips.ToolTip_ActivityName}"/>
														</DataTemplate>
													</DataGridTemplateColumn.HeaderTemplate>
													<DataGridTemplateColumn.CellTemplate>
														<DataTemplate x:DataType="contract:IResourceTimesheetRowViewModel">
															<Grid VerticalAlignment="Stretch">
																<TextBlock VerticalAlignment="Center"
																		   Margin="0"
																		   Padding="3"
																		   Text="{Binding Path=ActivityName, Mode=OneWay}"
																		   ToolTip.Tip="{Binding Path=ActivityLabel, Mode=OneWay}"
																		   TextTrimming="CharacterEllipsis"/>
															</Grid>
														</DataTemplate>
													</DataGridTemplateColumn.CellTemplate>
												</DataGridTemplateColumn>

												<DataGridTemplateColumn CanUserResize="False"
																		CanUserReorder="False"
																		CanUserSort="False"
																		Width="65">
													<DataGridTemplateColumn.HeaderTemplate>
														<DataTemplate>
															<TextBlock VerticalAlignment="Center"
																	   Margin="0"
																	   Padding="3"
																	   Text="{x:Static resources:Labels.Label_Find}"
																	   ToolTip.Tip="{x:Static resources:ToolTips.ToolTip_Find}"/>
														</DataTemplate>
													</DataGridTemplateColumn.HeaderTemplate>
													<DataGridTemplateColumn.CellTemplate>
														<DataTemplate x:DataType="contract:IResourceTimesheetRowViewModel">
															<Grid VerticalAlignment="Stretch">
																<Button Margin="0"
																		Padding="0"
																		VerticalAlignment="Stretch"
																		VerticalContentAlignment="Center"
																		HorizontalAlignment="Stretch"
																		HorizontalContentAlignment="Center"
																		FontWeight="ExtraBold"
																		Command="{Binding Path=SetTrackerIndexCommand, Mode=OneWay}"
																		CommandParameter="{Binding Path=LastTrackerIndex, Mode=OneWay}"
																		Content="{Binding Path=SearchSymbol, Mode=OneWay}"/>
															</Grid>
														</DataTemplate>
													</DataGridTemplateColumn.CellTemplate>
												</DataGridTemplateColumn>

												<!--The day columns are appended here by TimesheetDayColumnsBehavior.-->
											</DataGrid.Columns>

											<!-- Declared after the columns so the static columns already
											     exist when the behavior attaches and appends the day columns. -->
											<Interaction.Behaviors>
												<local:TimesheetDayColumnsBehavior/>
												<local:DataGridCommitEditBehavior/>
											</Interaction.Behaviors>
										</DataGrid>

										<StackPanel Orientation="Horizontal"
													Margin="0,1">
											<Border Width="55"/>
											<Border Width="{Binding Path=NameColumnWidth, Mode=OneWay}">
												<TextBlock Text="{x:Static resources:Labels.Label_DayTotal}"
														   Opacity="0.6"
														   Padding="3"
														   VerticalAlignment="Center"/>
											</Border>
											<Border Width="65"/>
											<ItemsControl ItemsSource="{Binding Path=DayTotals, Mode=OneWay}">
												<ItemsControl.ItemsPanel>
													<ItemsPanelTemplate>
														<StackPanel Orientation="Horizontal"/>
													</ItemsPanelTemplate>
												</ItemsControl.ItemsPanel>
												<ItemsControl.ItemTemplate>
													<DataTemplate x:DataType="contract:ITimesheetDayTotalViewModel">
														<Border Width="115"
																Margin="2,0"
																CornerRadius="8"
																Background="{Binding Path=Load, Mode=OneWay, Converter={x:Static local:TrackingConverters.DayLoadToBackground}}">
															<TextBlock Text="{Binding Path=TotalDisplay, Mode=OneWay}"
																	   TextAlignment="Center"
																	   Padding="3"
																	   VerticalAlignment="Center"/>
														</Border>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</StackPanel>

										<ComboBox Width="190"
												  Margin="0,3,0,1"
												  HorizontalAlignment="Left"
												  PlaceholderText="{x:Static resources:Labels.Label_AddActivity}"
												  ToolTip.Tip="{x:Static resources:ToolTips.ToolTip_AddActivity}"
												  ItemsSource="{Binding Path=CandidateActivities, Mode=OneWay}"
												  SelectedItem="{Binding Path=SelectedCandidateActivity, Mode=TwoWay}">
											<ComboBox.ItemTemplate>
												<DataTemplate x:DataType="contract:ITimesheetCandidateActivityViewModel">
													<TextBlock Text="{Binding Path=DisplayName, Mode=OneWay}"/>
												</DataTemplate>
											</ComboBox.ItemTemplate>
										</ComboBox>
									</StackPanel>
								</Expander>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</DockPanel>
	</DockPanel>
</UserControl>
