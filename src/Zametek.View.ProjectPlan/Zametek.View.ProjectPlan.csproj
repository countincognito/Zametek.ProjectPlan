<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
	<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
	<Platforms>AnyCPU;ARM64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
    <!-- Avalonia.Desktop is deliberately absent: it is the desktop windowing backends (Win32, X11, macOS),
         which a view library has no business pulling in - nothing here references it, and carrying it would
         drag all three backends into the browser head's WebAssembly bundle. The desktop head references it. -->
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Dock.Avalonia" Version="12.1.0" />
    <PackageReference Include="Irihi.Ursa" Version="2.2.0" />
    <PackageReference Include="Markdown.Avalonia.SyntaxHigh" Version="11.0.3" />
    <PackageReference Include="MessageBox.Avalonia" Version="12.0.0" />
	  <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.0" />
	  <PackageReference Include="ScottPlot.Avalonia" Version="5.1.59" />
	  <PackageReference Include="Semi.Avalonia" Version="12.1.0.1" />
	  <PackageReference Include="Semi.Avalonia.ColorPicker" Version="12.1.0.1" />
	  <PackageReference Include="Semi.Avalonia.DataGrid" Version="12.1.0.1" />
	  <PackageReference Include="Xaml.Behaviors.Avalonia" Version="12.0.5" />
	  <PackageReference Include="Xaml.Behaviors.Interactions.DragAndDrop.DataGrid" Version="12.0.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Zametek.Common.ProjectPlan\Zametek.Common.ProjectPlan.csproj" />
    <ProjectReference Include="..\Zametek.Resource.ProjectPlan\Zametek.Resource.ProjectPlan.csproj" />
    <ProjectReference Include="..\Zametek.ViewModel.ProjectPlan\Zametek.ViewModel.ProjectPlan.csproj" />
    <ProjectReference Include="..\Zametek.Graphs.Avalonia\Zametek.Graphs.Avalonia.csproj" />
  </ItemGroup>
</Project>
