<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Platforms>AnyCPU;ARM64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Zametek.Engine.ProjectPlan\Zametek.Engine.ProjectPlan.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Read a workbook by its XML alone, as the tests of the view models do: a test of a job reads when the workbook was created. -->
    <Compile Include="..\Zametek.ViewModel.ProjectPlan.Tests\Xlsx\XlsxPackageReader.cs" Link="Xlsx\XlsxPackageReader.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The plans zpp's own tests run, shared rather than copied: the engine runs them the same way. -->
    <Content Include="..\Zametek.ProjectPlan.CommandLine.Tests\Assets\**" LinkBase="Assets">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- A plan of a size and shape a real project has - dozens of activities and resources, graph layouts - which the
         view model tests read as well. -->
    <Content Include="..\Zametek.ViewModel.ProjectPlan.Tests\TestFiles\sample_v0_6_1.zpp" LinkBase="Assets">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Each plan that the repository ships or that its tests read, of each version: the check before the load must refuse
         none of them. -->
    <Content Include="..\..\docs\assets\*.zpp" LinkBase="RepositoryPlans\docs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Zametek.Data.ProjectPlan.Tests\TestFiles\*.zpp" LinkBase="RepositoryPlans\data">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Zametek.ViewModel.ProjectPlan.Tests\TestFiles\*.zpp" LinkBase="RepositoryPlans\viewmodel">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Zametek.ProjectPlan.CommandLine.Tests\Assets\*.zpp" LinkBase="RepositoryPlans\commandline">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
