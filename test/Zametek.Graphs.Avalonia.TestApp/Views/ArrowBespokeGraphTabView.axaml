<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:g="using:Zametek.Graphs.Avalonia"
             xmlns:vm="using:Zametek.Graphs.Avalonia.TestApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:DataType="vm:ArrowBespokeGraphTabViewModel"
             x:Class="Zametek.Graphs.Avalonia.TestApp.Views.ArrowBespokeGraphTabView">

    <UserControl.Resources>
        <!-- Library-provided converter: shifts a canvas-positioned control by minus half its own size so
             it centres on its anchor point (reused here for the edge label chip). -->
        <g:HalfNegativeConverter x:Key="halfNegative"/>

        <!-- Bespoke node body: a glowing circular "token". Only the node BODY is templated - the library
             still owns positioning, dragging, the selection ring and dimming, and feeds this template an
             IGraphNodeViewModel. Event nodes are uniform in an arrow graph, so a fixed vibrant fill is used;
             the number, tooltip and (white) label colour still come from the view-model. -->
        <DataTemplate x:Key="ArrowBespokeNodeTemplate" x:DataType="g:IGraphNodeViewModel">
            <Grid>
                <Ellipse Stroke="{Binding Path=BorderBrush, Mode=OneWay}"
                         StrokeThickness="2">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#6D8BFF"/>
                            <GradientStop Offset="1" Color="#2A3F9D"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#6D8BFF" BlurRadius="16" OffsetX="0" OffsetY="0" Opacity="0.75"/>
                    </Ellipse.Effect>
                </Ellipse>
                <TextBlock Text="{Binding Path=Label, Mode=OneWay}"
                           FontFamily="{Binding Path=LabelFontFamily, Mode=OneWay}"
                           FontSize="{Binding Path=LabelFontSize, Mode=OneWay}"
                           FontWeight="Bold"
                           Foreground="{Binding Path=LabelBrush, Mode=OneWay}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
        </DataTemplate>

        <!-- Bespoke edge appearance: a soft-glowing line with round caps and a rounded label "chip". The
             library owns the wide invisible hit area + tooltip; this template draws the line, arrowhead and
             label from IGraphEdgeViewModel. The chip text is deliberately fixed-light (it sits on a dark
             chip on either theme). -->
        <DataTemplate x:Key="ArrowBespokeEdgeTemplate" x:DataType="g:IGraphEdgeViewModel">
            <Canvas>
                <Path Data="{Binding Path=EdgeGeometry, Mode=OneWay}"
                      Stroke="{Binding Path=Stroke, Mode=OneWay}"
                      StrokeThickness="{Binding Path=StrokeThickness, Mode=OneWay}"
                      StrokeDashArray="{Binding Path=StrokeDashArray, Mode=OneWay}"
                      StrokeLineCap="Round"
                      Opacity="{Binding Path=EdgeOpacity, Mode=OneWay}"
                      IsHitTestVisible="False">
                    <Path.Effect>
                        <DropShadowEffect Color="#3B82F6" BlurRadius="7" OffsetX="0" OffsetY="0" Opacity="0.4"/>
                    </Path.Effect>
                </Path>
                <Polygon Points="{Binding Path=ArrowPoints, Mode=OneWay}"
                         Fill="{Binding Path=Stroke, Mode=OneWay}"
                         Opacity="{Binding Path=EdgeOpacity, Mode=OneWay}"/>
                <Border Name="labelChip"
                        Canvas.Left="{Binding Path=LabelX, Mode=OneWay}"
                        Canvas.Top="{Binding Path=LabelY, Mode=OneWay}"
                        IsVisible="{Binding Path=ShowLabel, Mode=OneWay}"
                        Opacity="{Binding Path=EdgeOpacity, Mode=OneWay}"
                        Background="#1B2A4A"
                        BorderBrush="#3B82F6"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="7,2">
                    <Border.RenderTransform>
                        <TranslateTransform X="{Binding #labelChip.Bounds.Width, Converter={StaticResource halfNegative}}"
                                            Y="{Binding #labelChip.Bounds.Height, Converter={StaticResource halfNegative}}"/>
                    </Border.RenderTransform>
                    <TextBlock Text="{Binding Path=Label, Mode=OneWay}"
                               FontFamily="{Binding Path=LabelFontFamily, Mode=OneWay}"
                               FontSize="{Binding Path=LabelFontSize, Mode=OneWay}"
                               Foreground="#EAF1FB"/>
                </Border>
            </Canvas>
        </DataTemplate>
    </UserControl.Resources>

    <!-- ExportMode="Raster": the built-in default export reproduces the real neon templates exactly. The
         context menu still offers both Vector and High-Fidelity entries; the matching vector silhouette
         (ellipse + label chip) is configured in code-behind via VectorExportStyle. -->
    <g:InteractiveGraphView x:Name="GraphView"
                            DataContext="{Binding Interactive}"
                            ExportMode="Raster"
                            NodeTemplate="{StaticResource ArrowBespokeNodeTemplate}"
                            EdgeTemplate="{StaticResource ArrowBespokeEdgeTemplate}"/>

</UserControl>
