<?xml version="1.0" encoding="utf-8"?>
<!--
  The package sources of this repository: nuget.org only. Without this file, a restore used each package source of the
  computer, for example a local folder. The packages of a release then came from whatever sources the computer of the
  build had, and a package in a local source with the name of a real package could go into a release. The mapping sends
  each package to nuget.org. To build with the source code of Zametek.Maths.Graphs, use Zametek.Maths.Graphs.local.targets
  (BUILDING.md), not a local package source.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
