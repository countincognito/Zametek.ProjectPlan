#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "Running pre-commit checks..."

echo "-> Checking code style..."
dotnet format style --verify-no-changes --verbosity quiet Zametek.ProjectPlan.slnf
if [ $? -ne 0 ]; then
  echo "Style check failed. Run 'dotnet format style' to fix."
  exit 1
fi

echo "-> Checking analyzer rules..."
dotnet format analyzers --verify-no-changes --verbosity quiet Zametek.ProjectPlan.slnf
if [ $? -ne 0 ]; then
  echo "Analyzer check failed. Run 'dotnet format analyzers' to fix."
  exit 1
fi

echo "-> Building main app..."
dotnet build --no-restore --configuration Debug --verbosity quiet Zametek.ProjectPlan.slnf
if [ $? -ne 0 ]; then
  echo "Build failed. Fix compilation errors before committing."
  exit 1
fi

# A test that waits for ever (a deadlock that comes back, say) ends the run after 10 minutes, and the output names the test.
# The slowest tests take about 3 minutes.
echo "-> Running all tests..."
dotnet test --no-build --configuration Debug --verbosity quiet --blame-hang-timeout 10m --blame-hang-dump-type none Zametek.ProjectPlan.slnf
if [ $? -ne 0 ]; then
  echo "Tests failed. Fix failing tests before committing."
  exit 1
fi

echo "All pre-commit checks passed."
